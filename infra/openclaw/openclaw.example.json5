{
  gateway: {
    mode: "local",
  },
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace",
    },
    list: [
      {
        id: "pm",
        workspace: "infra/openclaw/workspace/pm",
      },
      {
        id: "research",
        workspace: "infra/openclaw/workspace/research",
      },
      {
        id: "developer",
        workspace: "infra/openclaw/workspace/developer",
      },
    ],
  },
  tools: {
    profile: "coding",
  },
}
