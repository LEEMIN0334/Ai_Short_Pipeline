# === Postgres (Supabase) ===
POSTGRES_URL=postgresql://user:pass@host:5432/db

# === Cloudflare R2 ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-shorts-media

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Local storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.local_storage

# === Gemini ===
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === Typecast ===
TYPECAST_API_KEY=
TYPECAST_VOICE_ID=
TYPECAST_MODEL=ssfm-v30

# === YouTube Data API ===
YOUTUBE_API_KEY=

# === Reddit API ===
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-shorts-studio/0.1

# === Telegram bot ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_RESEARCH_BOT_TOKEN=
TELEGRAM_DEVELOPER_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# === Codex-backed agents ===
OPENCLAW_CODEX_APP_SERVER_BIN=
RESEARCH_CODEX_MODEL=gpt-5.5
RESEARCH_CODEX_REASONING_EFFORT=xhigh
RESEARCH_CODEX_TIMEOUT_SECONDS=900
DEVELOPER_CODEX_MODEL=gpt-5.5
DEVELOPER_CODEX_TIMEOUT_SECONDS=900
