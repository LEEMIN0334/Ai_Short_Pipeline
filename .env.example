# === Postgres (Supabase) ===
POSTGRES_URL=postgresql://user:pass@host:5432/db

# === Cloudflare R2 ===
# Use local storage for Phase 0 development. Switch to r2 later if needed.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=.local_storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ai-shorts-media

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Gemini ===
GEMINI_API_KEY=

# === Typecast ===
TYPECAST_API_KEY=
